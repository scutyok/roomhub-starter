### Variables
@baseUrl = http://localhost:5090

### 1. Create room
# @name createRoom
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Study room 1",
  "capacity": 10
}

###
@roomId = {{createRoom.response.body.$.id}}

### 2. Get room
GET {{baseUrl}}/api/rooms/{{roomId}}

### 3. Get a missing room (expected: 404)
GET {{baseUrl}}/api/rooms/00000000-0000-0000-0000-000000000001

### 4. Create booking (change the dates to the future!)
# @name createBooking
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

###
@bookingId = {{createBooking.response.body.$.id}}

### 5. Get booking
GET {{baseUrl}}/api/bookings/{{bookingId}}

### 6. Overlapping booking (expected: 409)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "bogdan",
  "startUtc": "2030-01-10T11:00:00Z",
  "endUtc": "2030-01-10T13:00:00Z",
  "attendees": 4
}

### 7. Cancel booking
POST {{baseUrl}}/api/bookings/{{bookingId}}/cancel

### 8. Create a large room (capacity 11)
# @name createLargeRoom
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Large study room",
  "capacity": 11
}

###
@largeRoomId = {{createLargeRoom.response.body.$.id}}

### 9. R10 - exactly 2 hours is allowed in a room with capacity 11
POST {{baseUrl}}/api/rooms/{{largeRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "large-room-user",
  "startUtc": "2030-02-10T10:00:00Z",
  "endUtc": "2030-02-10T12:00:00Z",
  "attendees": 11
}

### 10. R10 - more than 2 hours is rejected with 400
POST {{baseUrl}}/api/rooms/{{largeRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "large-room-user",
  "startUtc": "2030-02-10T13:00:00Z",
  "endUtc": "2030-02-10T15:01:00Z",
  "attendees": 11
}

### 11. R9 - first active booking on a UTC day for ana
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-03-10T10:00:00Z",
  "endUtc": "2030-03-10T11:00:00Z",
  "attendees": 2
}

### 12. R9 - second active booking on the same UTC day across rooms
POST {{baseUrl}}/api/rooms/{{largeRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-03-10T12:00:00Z",
  "endUtc": "2030-03-10T13:00:00Z",
  "attendees": 2
}

### 13. R9 - third active booking on the same UTC day is rejected with 409
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-03-10T14:00:00Z",
  "endUtc": "2030-03-10T15:00:00Z",
  "attendees": 2
}

### 14. R11 - cancel a booking starting at least 60 minutes later (expected 204)
POST {{baseUrl}}/api/bookings/{{bookingId}}/cancel

### 15. R11 - create a near-future booking
### Change the timestamps immediately before sending so the start is less than 60 minutes from now.
# @name nearFutureBooking
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "near-future-user",
  "startUtc": "2026-11-19T10:30:00Z",
  "endUtc": "2026-11-19T11:30:00Z",
  "attendees": 2
}

###
@nearFutureBookingId = {{nearFutureBooking.response.body.$.id}}

### 16. R11 - cancel less than 60 minutes before start (expected 409)
### Use only after updating the timestamps above to a near-future interval.
POST {{baseUrl}}/api/bookings/{{nearFutureBookingId}}/cancel
